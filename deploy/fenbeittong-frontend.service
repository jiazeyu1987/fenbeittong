[Unit]
Description=Fenbeitong Kingdee Expense Reimbursement Assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=system
Group=system
WorkingDirectory=/home/system/fenbeittong-offline
Environment=NODE_ENV=production
Environment=FENBEITONG_ASSISTANT_HOST=0.0.0.0
Environment=FENBEITONG_ASSISTANT_PORT=18734
Environment=FENBEITONG_ASSISTANT_TICKET_VALIDATE_URL=http://127.0.0.1:48081/admin-api/system/auth/fenbeitong-assistant-ticket/validate
Environment=FENBEITONG_ASSISTANT_SESSION_TTL_SECONDS=14400
Environment=APP_DATA_DIR=/home/system/fenbeittong-offline-data
ExecStart=/home/system/.local/opt/node/bin/node server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
